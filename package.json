{
  "name": "typst-side-agent",
  "version": "1.1.1",
  "private": true,
  "description": "Chrome extension: Typst Side Agent — AI assistant for typst.app with custom tools and MCP servers",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "vendor:update": "node scripts/vendor-sidepanel-libs.mjs update",
    "vendor:verify": "node scripts/vendor-sidepanel-libs.mjs verify",
    "package": "node scripts/package-extension.mjs",
    "package:check": "node scripts/check-package.mjs",
    "audit:release": "node scripts/check-dependency-audit.mjs",
    "lint": "eslint .",
    "check:imports": "node scripts/check-imports.mjs",
    "test:browser": "node --test test/browser/smoke.test.mjs",
    "coverage": "node scripts/check-coverage.mjs",
    "verify": "npm run lint && npm run check && npm run check:imports && npm run check:bridge && npm run check:lines && npm run vendor:verify && npm run coverage",
    "sync:bridge": "node scripts/sync-bridge-shared.mjs update",
    "check:bridge": "node scripts/sync-bridge-shared.mjs verify",
    "check:lines": "node scripts/check-line-length.mjs"
  },
  "devDependencies": {
    "dompurify": "3.4.13",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "jsdom": "30.1.2",
    "marked": "12.0.0",
    "playwright-core": "1.62.1"
  }
}
